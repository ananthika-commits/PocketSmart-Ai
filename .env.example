# PocketSmart AI Environment Configuration
# Copy this file to .env and insert your API keys

# Security Secret Key for Session Cookies & Cryptography
SECRET_KEY=pocketsmart-secure-session-secret-key-prod-2026

# SQLite Database Location
DATABASE_URL=sqlite:///./pocketsmart.db

# Google Gemini API Key
# Obtain for free from Google AI Studio: https://aistudio.google.com/ or https://console.cloud.google.com
# If left blank, PocketSmart AI automatically runs in smart algorithmic fallback mode with full functionality.
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True
